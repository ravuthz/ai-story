# Server
PORT=3001
STORAGE_DIR=./storage
DATABASE_PATH=./storage/ai-story.sqlite

# Default providers (text: codex|claude|gemini|agy|omp ; image: codex|qwen|gemini ; audio: edge|gemini ; video: ffmpeg|gradio)
DEFAULT_TEXT_PROVIDER=codex
DEFAULT_IMAGE_PROVIDER=qwen
DEFAULT_AUDIO_PROVIDER=edge
DEFAULT_VIDEO_PROVIDER=ffmpeg

# Agent CLIs: <ID>_BIN = executable name or absolute path ("~/" allowed),
# <ID>_MODEL = optional model override (blank = the CLI's own config).
# The binary's folder is prepended to PATH when it runs (needed by e.g. omp's bun shebang).
CODEX_BIN=/opt/homebrew/bin/codex
CODEX_MODEL=
CLAUDE_BIN=~/.local/bin/claude
CLAUDE_MODEL=
GEMINI_BIN=gemini
GEMINI_MODEL=
AGY_BIN=~/.local/bin/agy
AGY_MODEL=
OMP_BIN=~/.bun/bin/omp
OMP_MODEL=
# Extra folders on PATH for all agent CLIs (their hooks/shebangs may need node, bun, ...)
AGENT_PATH=/opt/homebrew/bin:~/.bun/bin:~/.local/bin
# Each CLI's own config-location env vars set here are passed through too, e.g.
# CODEX_HOME=~/.codex-story   CLAUDE_CONFIG_DIR=~/.claude-story

# Gemini API (image + TTS)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Remote Qwen-Image Gradio space / URL
QWEN_GRADIO_URL=Qwen/Qwen-Image
QWEN_GRADIO_ENDPOINT=/infer
HF_TOKEN=

# Optional remote image-to-video Gradio space
VIDEO_GRADIO_URL=
VIDEO_GRADIO_ENDPOINT=/generate_video

# Job worker
WORKER_CONCURRENCY=2
CLI_TIMEOUT_MS=600000
